! ------------------------
!  {"f3":1}
! (1 row)
! 
! select json_extract_path_text('{"f2":["f3",1],"f4":{"f5":99,"f6":"stringy"}}','f2',0::text);
!  json_extract_path_text 
! ------------------------
!  f3
! (1 row)
! 
! select json_extract_path_text('{"f2":["f3",1],"f4":{"f5":99,"f6":"stringy"}}','f2',1::text);
!  json_extract_path_text 
! ------------------------
!  1
! (1 row)
