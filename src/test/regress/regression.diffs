! --
! -- XC_COPY
! --
! -- Tests related to COPY for a Postgres-XL cluster
! -- Create a table not using the first node of cluster
! SELECT create_table_nodes('xc_copy_1(a int, b int)', '{2}'::int[], 'replication', NULL);
!  create_table_nodes 
