! (1 row)
! 
! -- add to empty object
! select jsonb_set('{}','{x}','{"foo":123}');
!       jsonb_set      
! ---------------------
!  {"x": {"foo": 123}}
! (1 row)
! 
! --add to empty array
! select jsonb_set('[]','{0}','{"foo":123}');
!    jsonb_set    
! ----------------
!  [{"foo": 123}]
! (1 row)
! 
! select jsonb_set('[]','{99}','{"foo":123}');
!    jsonb_set    
! ----------------
!  [{"foo": 123}]
! (1 row)
! 
! select jsonb_set('[]','{-99}','{"foo":123}');
!    jsonb_set    
! ----------------
!  [{"foo": 123}]
! (1 row)
! 
