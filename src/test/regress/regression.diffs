! 		RETURN NEXT retval;
! 	ELSE
! 		SELECT INTO retval 50, 5::numeric, ''xxx''::text;
! 		RETURN NEXT retval;
! 		RETURN NEXT retval;
! 	END IF;
! 	RETURN;
! END;' language plpgsql;
