!  ftest1 | ftest2 
! --------+--------
!       1 |      2
!       2 |      3
!       3 |      4
!         |      1
! (4 rows)
! 
! -- Delete a row from PK TABLE
! DELETE FROM PKTABLE WHERE ptest1=1;
! -- Check FKTABLE for removal of matched row
! SELECT * FROM FKTABLE ORDER BY 1, 2;
