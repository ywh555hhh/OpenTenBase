! (3 rows)
! 
! -- check inheritance behavior
! explain (costs off)
!   select count(*) from person tablesample bernoulli (100);
!                          QUERY PLAN                          
! -------------------------------------------------------------
!  Finalize Aggregate
!    ->  Remote Subquery Scan on all (datanode_1,datanode_2)
!          ->  Partial Aggregate
