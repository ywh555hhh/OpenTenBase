! 			RETURN true;
! 		END IF;
! 	END LOOP;
! 	RETURN false;
! END;
! $$;
! -- A function to execute direct a query on a data node specified by the node number.
! create or replace function exec_util_on_node(query varchar, nodenum int) returns void as
! $D$
! DECLARE
! 	str varchar;
