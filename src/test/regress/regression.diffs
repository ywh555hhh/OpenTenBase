! -- Test for referencing column number smaller than referenced constraint
! CREATE TABLE PKTABLE (ptest1 int, ptest2 int, UNIQUE(ptest1, ptest2));
! CREATE TABLE FKTABLE_FAIL1 (ftest1 int REFERENCES pktable(ptest1));
