!                                  Output: xc_groupby_tab1.val, xc_groupby_tab1.val2
!                      ->  Sort
!                            Output: xc_groupby_tab2.val, xc_groupby_tab2.val2
!                            Sort Key: xc_groupby_tab2.val2
!                            ->  Seq Scan on public.xc_groupby_tab2
!                                  Output: xc_groupby_tab2.val, xc_groupby_tab2.val2
