!                Filter: (a IS NULL)
! (4 rows)
! 
! explain (costs off) select * from list_parted where a is not null;
!                      QUERY PLAN                      
! -----------------------------------------------------
!  Remote Subquery Scan on all (datanode_1,datanode_2)
!    ->  Append
!          ->  Seq Scan on part_ab_cd
!                Filter: (a IS NOT NULL)
!          ->  Seq Scan on part_ef_gh
!                Filter: (a IS NOT NULL)
!          ->  Seq Scan on part_null_xy
!                Filter: (a IS NOT NULL)
! (8 rows)
! 
