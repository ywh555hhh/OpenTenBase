! -------
!     10
! (1 row)
! 
! CREATE VIEW test_tablesample_v1 AS
!   SELECT id FROM test_tablesample TABLESAMPLE SYSTEM (10*2) REPEATABLE (2);
! CREATE VIEW test_tablesample_v2 AS
!   SELECT id FROM test_tablesample TABLESAMPLE SYSTEM (99);
