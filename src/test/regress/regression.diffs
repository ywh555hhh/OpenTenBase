! 	 '{>, >=, =, <=, <}',
! 	 '{0000000000000100, 0000000000000100, 0001010001100110, 1111111111111000, 1111111111111000}',
! 	 '{100, 100, 1, 100, 100}'),
! 	('numericcol', 'numeric',
! 	 '{>, >=, =, <=, <}',
! 	 '{0.00, 0.01, 2268164.347826086956521739130434782609, 99470151.9, 99470151.9}',
! 	 '{100, 100, 1, 100, 100}'),
