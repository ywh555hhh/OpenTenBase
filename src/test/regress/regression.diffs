!  nextval 
! ---------
!        1
! (1 row)
! 
! SELECT nextval('sequence_test'::regclass);
!  nextval 
! ---------
!        2
! (1 row)
! 
! SELECT currval('sequence_test'::text);
!  currval 
! ---------
!        2
! (1 row)
! 
! SELECT currval('sequence_test'::regclass);
!  currval 
! ---------
!        2
! (1 row)
! 
! SELECT setval('sequence_test'::text, 32);
!  setval 
! --------
!      32
! (1 row)
! 
