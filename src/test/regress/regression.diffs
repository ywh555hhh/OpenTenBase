!  nextval 
! ---------
!        1
! (1 row)
! 
! DROP SEQUENCE xl_s1;
! ROLLBACK;
! SELECT nextval('xl_s1');
!  nextval 
! ---------
!        2
! (1 row)
! 
! DROP SEQUENCE xl_s1;
! -- A combination of ALTER and RENAME should work ok when transacion commits
! CREATE SEQUENCE xl_s1;
! SELECT nextval('xl_s1');
!  nextval 
! ---------
!        1
! (1 row)
! 
! SELECT nextval('xl_s1');
!  nextval 
! ---------
!        2
! (1 row)
! 
! BEGIN;
! ALTER SEQUENCE xl_s1 RESTART;
! SELECT nextval('xl_s1');	-- restart value
