! ALTER AGGREGATE alt_agg2(int) OWNER TO regress_alter_user3;  -- OK
! ALTER AGGREGATE alt_agg2(int) SET SCHEMA alt_nsp2;  -- OK
! SET SESSION AUTHORIZATION regress_alter_user2;
