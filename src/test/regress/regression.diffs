! ---+----
!  1 | b1
! (1 row)
! 
! CREATE TABLE test_like_id_2 (LIKE test_like_id_1);
! \d test_like_id_2
!            Table "public.test_like_id_2"
!  Column |  Type   | Collation | Nullable | Default 
! --------+---------+-----------+----------+---------
!  a      | integer |           | not null | 
!  b      | text    |           |          | 
! 
