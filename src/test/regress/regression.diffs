! ------------------+-------------------
!               123 |               456
!               123 |  4567890123456789
!  4567890123456789 | -4567890123456789
! (3 rows)
! 
! rollback;
! -- Check handling of non-backwards-scan-capable plans with scroll cursors
! begin;
! explain (costs off) declare c1 cursor for select (select 42) as x;
