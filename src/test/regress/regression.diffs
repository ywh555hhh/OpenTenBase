! --------+--------+--------+--------
!       0 |        |        |      1
!       2 |        |      3 |      3
!         |      2 |      3 |      2
!         |      2 |      7 |      4
!         |      3 |      4 |      5
!         |        |        |      1
! (6 rows)
! 
! -- Try to delete something that should not set default
! DELETE FROM PKTABLE where ptest2=5;
! -- Show PKTABLE and FKTABLE
! SELECT * from PKTABLE ORDER BY 1, 2, 3,4;
!  ptest1 | ptest2 | ptest3 | ptest4 
! --------+--------+--------+--------
