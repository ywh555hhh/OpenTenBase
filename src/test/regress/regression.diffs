! -- tmp4 is a,b
! ALTER TABLE tmp5 add constraint tmpconstr foreign key(a) references tmp4(a) match full;
! ERROR:  there is no unique constraint matching given keys for referenced table "tmp4"
! DROP TABLE tmp7;
