!       ORDER BY tt1_id, tt2_id; 
!  tt1_id | joincol | tt2_id | joincol 
! --------+---------+--------+---------
!       1 |      11 |     21 |      11
!       1 |      11 |     22 |      11
!       2 |         |        |        
! (3 rows)
! 
! select tt1.*, tt2.* from tt2 right join tt1 on tt1.joincol = tt2.joincol 
!       ORDER BY tt1_id, tt2_id; 
!  tt1_id | joincol | tt2_id | joincol 
! --------+---------+--------+---------
