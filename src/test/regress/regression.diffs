!      QUERY PLAN     
! --------------------
!  Materialize
!    ->  ProjectSet
!          ->  Result
! (3 rows)
! 
! declare c2 scroll cursor for select generate_series(1,3) as g;
! fetch all in c2;
!  g 
! ---
!  1
!  2
!  3
! (3 rows)
! 
! fetch backward all in c2;
!  g 
! ---
!  3
!  2
!  1
! (3 rows)
! 
