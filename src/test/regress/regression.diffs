! -- corner cases for same
! select '{"a": {"b":{"c": "foo"}}}'::json #> '{}';
!          ?column?          
! ---------------------------
!  {"a": {"b":{"c": "foo"}}}
! (1 row)
! 
! select '[1,2,3]'::json #> '{}';
!  ?column? 
! ----------
!  [1,2,3]
! (1 row)
! 
! select '"foo"'::json #> '{}';
!  ?column? 
! ----------
!  "foo"
! (1 row)
! 
! select '42'::json #> '{}';
!  ?column? 
! ----------
!  42
! (1 row)
! 
! select 'null'::json #> '{}';
!  ?column? 
! ----------
!  null
! (1 row)
! 
! select '{"a": {"b":{"c": "foo"}}}'::json #> array['a'];
!       ?column?      
! --------------------
!  {"b":{"c": "foo"}}
! (1 row)
! 
