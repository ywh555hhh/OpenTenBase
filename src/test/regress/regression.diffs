! ------------------------
!  
! (1 row)
! 
! SELECT brin_desummarize_range('brinidx', 0);
!  brin_desummarize_range 
! ------------------------
!  
! (1 row)
! 
! SELECT brin_desummarize_range('brinidx', 100000000);
