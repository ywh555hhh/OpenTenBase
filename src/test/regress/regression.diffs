! -- Check FKTABLE for update of matched row
! SELECT * FROM FKTABLE ORDER BY 1, 2;
!  ftest1 | ftest2 
! --------+--------
!       1 |      3
!       3 |      4
!         |      1
! (3 rows)
! 
! DROP TABLE FKTABLE;
! DROP TABLE PKTABLE;
