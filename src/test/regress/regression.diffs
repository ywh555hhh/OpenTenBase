! --------+--------+--------+--------
!       0 |     -1 |     -2 |      1
!       0 |     -1 |     -2 |      1
!       2 |      3 |      4 |      1
!       2 |        |      3 |      3
!         |      2 |      3 |      2
!         |      2 |      7 |      4
!         |      3 |      4 |      5
! (7 rows)
! 
