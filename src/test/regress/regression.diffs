! RESET enable_seqscan;
! DROP INDEX jidx;
! -- nested tests
! SELECT '{"ff":{"a":12,"b":16}}'::jsonb;
!            jsonb            
! ----------------------------
!  {"ff": {"a": 12, "b": 16}}
! (1 row)
! 
! SELECT '{"ff":{"a":12,"b":16},"qq":123}'::jsonb;
!                  jsonb                 
! ---------------------------------------
!  {"ff": {"a": 12, "b": 16}, "qq": 123}
! (1 row)
! 
! SELECT '{"aa":["a","aaa"],"qq":{"a":12,"b":16,"c":["c1","c2"],"d":{"d1":"d1","d2":"d2","d1":"d3"}}}'::jsonb;
