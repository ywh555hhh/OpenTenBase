!  (0,8) |   12 |     22
!  (0,9) |   12 |    454
! (3 rows)
! 
! -- ROLLBACK TO s1;
! SELECT ctid,cmin,* FROM combocidtest ORDER BY ctid;
!  ctid  | cmin | foobar 
! -------+------+--------
!  (0,7) |   12 |     21
!  (0,8) |   12 |     22
!  (0,9) |   12 |    454
! (3 rows)
! 
! COMMIT;
! SELECT ctid,cmin,* FROM combocidtest ORDER BY ctid;
!  ctid  | cmin | foobar 
! -------+------+--------
!  (0,7) |   12 |     21
!  (0,8) |   12 |     22
!  (0,9) |   12 |    454
! (3 rows)
