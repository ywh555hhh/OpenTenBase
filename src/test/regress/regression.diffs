! DELETE FROM PKTABLE where ptest1=2 and ptest2=3 and ptest3=4;
! -- Show PKTABLE and FKTABLE
! SELECT * from PKTABLE ORDER BY 1, 2, 3,4;
!  ptest1 | ptest2 | ptest3 | ptest4 
! --------+--------+--------+--------
!       0 |     -1 |     -2 | test1
!       1 |      2 |      3 | test2
!       2 |     -1 |      5 | test5
