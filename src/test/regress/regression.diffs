! ------------------------------------------------------------
!  {"a": 1, "b": [0, 1, 2], "c": {"d": 4, "e": {"foo": 123}}}
! (1 row)
! 
! -- adding doesn't do anything if elements before last aren't present
! select jsonb_set('{"a":1,"b":[0,1,2],"c":{"d":4}}','{x,-33}','{"foo":123}');
