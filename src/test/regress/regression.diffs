!                         jsonb_insert                        
! ------------------------------------------------------------
!  {"a": {"b": {"c": [0, 1, "test1", "new_value", "test2"]}}}
! (1 row)
! 
! select jsonb_insert('{"a": [0,1,2]}', '{a, 1}', '{"b": "value"}');
!            jsonb_insert           
! ----------------------------------
!  {"a": [0, {"b": "value"}, 1, 2]}
! (1 row)
! 
