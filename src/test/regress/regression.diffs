!    jsonb_delete   
! ------------------
!  {"b": 2, "c": 3}
! (1 row)
! 
! select jsonb_delete('{"a":null , "b":2, "c":3}'::jsonb, 'a');
!    jsonb_delete   
! ------------------
!  {"b": 2, "c": 3}
! (1 row)
! 
! select jsonb_delete('{"a":1 , "b":2, "c":3}'::jsonb, 'b');
