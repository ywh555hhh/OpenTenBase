! ----+----
!   1 | 11
!   2 | 12
!   3 | 13
!   4 | 14
! (4 rows)
! 
! select * from alter2.v1 order by f1, f2;
!  f1 | f2 
! ----+----
!   1 | 11
!   2 | 12
!   3 | 13
!   4 | 14
! (4 rows)
! 
! select alter2.plus1(41);
!  plus1 
! -------
!     42
! (1 row)
