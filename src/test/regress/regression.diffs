! ---+-----
!  1 |   3
!  2 |   2
!  3 |    
!  4 |    
! (4 rows)
! 
! SELECT i,SUM(v::int) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)
