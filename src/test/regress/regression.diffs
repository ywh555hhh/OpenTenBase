! --------+--------+--------+--------
!       1 |      2 |      3 |      1
!       2 |      3 |      4 |      1
!       2 |      4 |      5 |      1
!       2 |        |      3 |      3
!         |      2 |      3 |      2
!         |      2 |      7 |      4
!         |      3 |      4 |      5
! (7 rows)
! 
! -- Try to update something that will fail
! UPDATE PKTABLE set ptest2=5 where ptest2=2;
