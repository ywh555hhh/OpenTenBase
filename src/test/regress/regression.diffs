! --gin path opclass
! DROP INDEX jidx;
! CREATE INDEX jidx ON testjsonb USING gin (j jsonb_path_ops);
! SET enable_seqscan = off;
! SELECT count(*) FROM testjsonb WHERE j @> '{"wait":null}';
!  count 
! -------
