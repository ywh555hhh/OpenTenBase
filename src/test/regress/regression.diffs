! (1 row)
! 
! set work_mem = '3MB';
! -- but SET isn't
! create or replace function myfunc(int) returns text as $$
! begin
!   set work_mem = '2MB';
!   return current_setting('work_mem');
! end $$
! language plpgsql
! set work_mem = '1MB';
! select myfunc(0), current_setting('work_mem');
!  myfunc | current_setting 
! --------+-----------------
!  2MB    | 2MB
