!  b     |     1 |   3 |   3 |               2
!  a     |     2 |   1 |   2 |               3
!  b     |     1 |   3 |   3 |               3
! (6 rows)
! 
! -- grouping sets are a bit special, they produce NULLs in columns not actually NULL
! set enable_hashagg = false;
