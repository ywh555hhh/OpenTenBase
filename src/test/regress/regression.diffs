! -------------------------
!  [[2, 3, 4], 2, null, 3]
! (1 row)
! 
! -- jsonb_set adding instead of replacing
! -- prepend to array
! select jsonb_set('{"a":1,"b":[0,1,2],"c":{"d":4}}','{b,-33}','{"foo":123}');
