! SELECT name, statement, is_holdable, is_binary, is_scrollable FROM pg_cursors;
!  name  |                                    statement                                    | is_holdable | is_binary | is_scrollable 
! -------+---------------------------------------------------------------------------------+-------------+-----------+---------------
