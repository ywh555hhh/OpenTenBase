!                Filter: ((d >= '08-01-2009'::date) AND (d <= '08-31-2009'::date))
!          ->  Seq Scan on nv_child_2009
!                Filter: ((d >= '08-01-2009'::date) AND (d <= '08-31-2009'::date))
! (8 rows)
