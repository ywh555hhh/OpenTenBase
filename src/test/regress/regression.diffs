! ERROR:  cannot delete path in scalar
! select '{}'::jsonb #- '{a}';
!  ?column? 
! ----------
!  {}
! (1 row)
! 
! select '[]'::jsonb #- '{a}';
!  ?column? 
! ----------
!  []
! (1 row)
! 
