! DECLARE
! 	rec RECORD;
! BEGIN
! 	FOR rec IN select * from found_test_tbl LOOP
! 		RETURN NEXT rec;
! 	END LOOP;
! 	RETURN;
! END;' language plpgsql;
! select * from test_table_func_rec() order by 1;
!   a  
! -----
!    2
!    3
!    4
!    5
!    6
!  100
! (6 rows)
! 
